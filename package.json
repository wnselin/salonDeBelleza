{
  "name": "salon-booking-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Salon booking website template with an admin panel",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/src/server.ts",
    "build": "tsc -p server/tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p server/tsconfig.json --noEmit",
    "migrate": "node dist/scripts/migrate.js",
    "migrate:dev": "tsx server/src/scripts/migrate.ts",
    "admin:create": "node dist/scripts/create-admin.js",
    "admin:create:dev": "tsx server/src/scripts/create-admin.ts",
    "admin:reset": "node dist/scripts/reset-admin.js",
    "admin:reset:dev": "tsx server/src/scripts/reset-admin.ts",
    "backup": "node dist/scripts/backup.js",
    "backup:dev": "tsx server/src/scripts/backup.ts",
    "retention": "node dist/scripts/retention.js",
    "retention:dev": "tsx server/src/scripts/retention.ts",
    "restore": "node dist/scripts/restore.js",
    "restore:dev": "tsx server/src/scripts/restore.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "@inquirer/prompts": "^7.8.4",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.1",
    "libphonenumber-js": "^1.12.25",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "eslint": "^9.38.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "glob": "^14.0.3"
  }
}
