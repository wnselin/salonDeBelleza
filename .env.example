# --- Application ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=http://localhost:3000
PUBLIC_DIR=./public
MIGRATIONS_DIR=./migrations
DATA_DIR=./data

# --- Security / sessions ---
# true only behind HTTPS (production)
COOKIE_SECURE=false
# true only behind a trusted reverse proxy (Caddy in Docker)
TRUST_PROXY=false
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
# Disable only in automated tests
RATE_LIMIT_DISABLED=false

# --- Bookings / personal data ---
CONSENT_VERSION=2026-11-04
BOOKING_RETENTION_DAYS=90

# --- Backups ---
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=7
# 32 bytes, hex (64 characters). Generate: openssl rand -hex 32
# In production provide via Docker secret file instead (BACKUP_KEY_FILE).
BACKUP_KEY=CHANGE_ME_64_HEX_CHARS
# Optional: path to a file containing the key (used in Docker production).
# BACKUP_KEY_FILE=/run/secrets/backup_key

# --- Logs ---
LOG_LEVEL=info
