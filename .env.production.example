# --- Production (Docker Compose + Caddy) ---
# Copy to .env.production on the server, chmod 600, fill in real values.
# Never commit the filled file.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Public HTTPS origin. Used for CSRF/Origin checks — must match exactly.
APP_ORIGIN=https://example.ru
DOMAIN=example.ru

# --- Security / sessions ---
COOKIE_SECURE=true
TRUST_PROXY=true
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
RATE_LIMIT_DISABLED=false

# --- Bookings / personal data ---
CONSENT_VERSION=2026-11-04
BOOKING_RETENTION_DAYS=90

# --- Backups ---
# Inside the container; the volume is mounted at /app/data.
BACKUP_DIR=/app/data/backups
BACKUP_RETENTION_DAYS=7
# The key itself is supplied via Docker secret file (BACKUP_KEY_FILE),
# created on the server at ./secrets/backup_key (64 hex characters).

# --- Logs ---
LOG_LEVEL=info
